<local:HostedPage x:Class="Telegram.Views.Settings.SettingsAppearancePage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:contract7Present="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract, 7)"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:common="using:Telegram.Common"
                  xmlns:controls="using:Telegram.Controls"
                  xmlns:cells="using:Telegram.Controls.Cells"
                  xmlns:chats="using:Telegram.Controls.Chats"
                  xmlns:messages="using:Telegram.Controls.Messages"
                  xmlns:local="using:Telegram.Views"
                  xmlns:viewModels="using:Telegram.ViewModels.Settings"
                  mc:Ignorable="d"
                  NavigationMode="Root"
                  ActualThemeChanged="OnActualThemeChanged">

    <Grid Background="{ThemeResource SettingsPageBackground}">
        <contract7Present:Grid.BackgroundTransition>
            <contract7Present:BrushTransition />
        </contract7Present:Grid.BackgroundTransition>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <!-- The preview, held over the settings rather than scrolled away with them, so that
             whatever is changed below is seen changing. -->
        <controls:SettingsPanel x:Name="PreviewPanel"
                                Canvas.ZIndex="1">
            <controls:HeaderedControl>
                <Grid x:Name="PreviewCard"
                      BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                      CornerRadius="4">
                    <Border Background="{ThemeResource SettingsItemBackground}"
                            Visibility="{x:Bind ViewModel.PreviewHaze, Mode=OneWay}"
                            CornerRadius="4" />
                    <Grid x:Name="Preview"
                          CornerRadius="4">
                        <chats:ChatBackgroundControl x:Name="BackgroundControl"
                                                     CornerRadius="4" />
                        <StackPanel x:Name="Bubbles"
                                    Padding="0,4,0,12">
                            <messages:MessageService HorizontalAlignment="Center"
                                                     Margin="0,8,0,4">
                                <TextBlock Text="Сьогодні"
                                           Foreground="White"
                                           FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </messages:MessageService>
                            <messages:MessageBubble x:Name="Message1"
                                                    HorizontalAlignment="Left" />
                            <messages:MessageBubble x:Name="Message2"
                                                    HorizontalAlignment="Right"
                                                    IsOutgoing="True" />
                        </StackPanel>
                    </Grid>

                    <ToggleButton x:Name="HazeToggle"
                                  Content="Матовість"
                                  AutomationProperties.Name="Матовість перегляду"
                                  ToolTipService.ToolTip="Напівпрозора картка налаштувань під переглядом. Без неї перегляд виглядає точно як чат."
                                  IsChecked="{x:Bind ViewModel.PreviewHaze, Mode=TwoWay}"
                                  FontSize="12"
                                  Padding="10,3"
                                  MinHeight="0"
                                  Margin="0,8,8,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top" />
                </Grid>
            </controls:HeaderedControl>
        </controls:SettingsPanel>

        <ScrollViewer x:Name="ScrollingHost"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      Grid.Row="1">
            <controls:SettingsPanel SizeChanged="OnSizeChanged"
                                    HasTopPadding="False">
                <controls:HeaderedControl>
                    <Grid Background="{ThemeResource SettingsItemBackground}"
                          BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                        <ListView x:Name="List"
                                  ItemsSource="{x:Bind ViewModel.ChatThemes}"
                                  SelectedItem="{x:Bind ViewModel.SelectedChatTheme, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  SingleSelectionFollowsFocus="False"
                                  SelectionChanged="OnSelectionChanged"
                                  ChoosingItemContainer="OnChoosingItemContainer"
                                  ContainerContentChanging="OnContainerContentChanging"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                  ScrollViewer.HorizontalScrollMode="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  Padding="12,12,0,8">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <cells:ChatThemeCell Width="87" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="controls:MultipleListViewItem">
                                    <Setter Property="Padding"
                                            Value="0" />
                                    <Setter Property="CornerRadius"
                                            Value="4" />
                                    <Setter Property="Margin"
                                            Value="0,0,4,4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.Footer>
                                <Border Width="8" />
                            </ListView.Footer>
                        </ListView>
                    </Grid>

                    <controls:SettingsButton Content="{CustomResource ChatThemes}"
                                             Click="{x:Bind ViewModel.OpenThemes}"
                                             Glyph="&#xE90E;"
                                             IsChevronVisible="True" />

                    <controls:SettingsButton Content="{CustomResource ChatWallpaper}"
                                             Click="{x:Bind ViewModel.OpenWallpaper}"
                                             Glyph="&#xE9E7;"
                                             IsChevronVisible="True" />

                    <controls:SettingsButton x:Name="NameColor"
                                             Content="{CustomResource YourNameColor}"
                                             Click="{x:Bind ViewModel.ChangeProfileColor}"
                                             Glyph="&#xE2B1;"
                                             IsChevronVisible="True">
                        <controls:SettingsButton.Badge>
                            <controls:ProfileColorBadge x:Name="ProfileColor" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                </controls:HeaderedControl>

                <controls:HeaderedControl Header="Повідомлення"
                                          Footer="Попередній перегляд угорі змінюється разом із цими налаштуваннями. У відкритих чатах скло й сяйво з'являються, щойно повідомлення перемальовуються: прокрутіть або знову відкрийте чат.">

                    <CheckBox common:ToggleHelper.IsChecked="{x:Bind ViewModel.UseCustomMessageColors, Mode=TwoWay}"
                              AutomationProperties.Name="Власні кольори"
                              Content="Власні кольори повідомлень (замість кольорів теми)"
                              Style="{StaticResource SettingsCheckBoxStyle}" />
                    <controls:SettingsButton Content="Вхідні бульбашки"
                                             Tag="CustomIncomingColor"
                                             Click="CustomColor_Click"
                                             IsEnabled="{x:Bind ViewModel.UseCustomMessageColors, Mode=OneWay}"
                                             Glyph="&#xE8BD;">
                        <controls:SettingsButton.Badge>
                            <Border Width="36" Height="22" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                                    Background="{x:Bind ViewModel.CustomIncomingBrush, Mode=OneWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Вихідні бульбашки"
                                             Tag="CustomOutgoingColor"
                                             Click="CustomColor_Click"
                                             IsEnabled="{x:Bind ViewModel.UseCustomMessageColors, Mode=OneWay}"
                                             Glyph="&#xF7C9;">
                        <controls:SettingsButton.Badge>
                            <Border Width="36" Height="22" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                                    Background="{x:Bind ViewModel.CustomOutgoingBrush, Mode=OneWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Текст вхідних"
                                             Tag="CustomIncomingTextColor"
                                             Click="CustomColor_Click"
                                             IsEnabled="{x:Bind ViewModel.UseCustomMessageColors, Mode=OneWay}"
                                             Glyph="&#xE9BF;">
                        <controls:SettingsButton.Badge>
                            <Border Width="36" Height="22" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                                    Background="{x:Bind ViewModel.CustomIncomingTextBrush, Mode=OneWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Текст вихідних"
                                             Tag="CustomOutgoingTextColor"
                                             Click="CustomColor_Click"
                                             IsEnabled="{x:Bind ViewModel.UseCustomMessageColors, Mode=OneWay}"
                                             Glyph="&#xF7CA;">
                        <controls:SettingsButton.Badge>
                            <Border Width="36" Height="22" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                                    Background="{x:Bind ViewModel.CustomOutgoingTextBrush, Mode=OneWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Капсули реакцій (колір)"
                                             Tag="CustomReactionColor"
                                             Click="CustomColor_Click"
                                             IsEnabled="{x:Bind ViewModel.UseCustomMessageColors, Mode=OneWay}"
                                             Glyph="&#xF7A8;">
                        <controls:SettingsButton.Badge>
                            <Border Width="36" Height="22" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                                    Background="{x:Bind ViewModel.CustomReactionBrush, Mode=OneWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>

                    <controls:SettingsButton Content="Бульбашки"
                                             Glyph="&#xE992;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.GlassOptions}"
                                                       AutomationProperties.Name="Бульбашки"
                                                       SelectedIndex="{x:Bind ViewModel.BubbleGlassIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <Grid Background="{ThemeResource SettingsItemBackground}"
                          BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="24"
                                Height="24"
                                Margin="16,0,18,0">
                            <TextBlock FontSize="25"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw"
                                       Text="&#xF7A9;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </Border>

                        <TextBlock Text="{x:Bind ConvertPercent('Непрозорість бульбашок', ViewModel.BubbleOpacity), Mode=OneWay}"
                                   Opacity="{x:Bind ConvertEnabledOpacity(ViewModel.IsBubbleGlass), Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Grid.Column="1" />
                        <Slider Value="{x:Bind ViewModel.BubbleOpacity, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsBubbleGlass, Mode=OneWay}"
                                AutomationProperties.Name="Непрозорість бульбашок"
                                Minimum="20"
                                Maximum="100"
                                SmallChange="5"
                                LargeChange="10"
                                StepFrequency="5"
                                IsThumbToolTipEnabled="False"
                                Margin="12,6,16,6"
                                Grid.Column="2" />
                    </Grid>
                    <controls:SettingsButton Content="Капсули реакцій"
                                             Glyph="&#xE920;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.GlassOptions}"
                                                       AutomationProperties.Name="Капсули реакцій"
                                                       SelectedIndex="{x:Bind ViewModel.ReactionGlassIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Дати й сервісні повідомлення"
                                             Glyph="&#xF7AA;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.GlassOptions}"
                                                       AutomationProperties.Name="Сервісні капсули"
                                                       SelectedIndex="{x:Bind ViewModel.ServiceGlassIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Текст у повідомленнях"
                                             Glyph="&#xEAA9;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.MessageTextStyleOptions}"
                                                       AutomationProperties.Name="Текст у повідомленнях"
                                                       SelectedIndex="{x:Bind ViewModel.MessageTextStyleIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                </controls:HeaderedControl>

                <controls:HeaderedControl>
                    <CheckBox Content="{CustomResource SettingsSwitchToNightMode}"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.ForceNightMode, Mode=TwoWay}" />
                    <controls:SettingsButton Content="{CustomResource AutoNightTheme}"
                                             Badge="{x:Bind ConvertNightMode(ViewModel.NightMode), Mode=OneWay}"
                                             Click="{x:Bind ViewModel.OpenNightMode}"
                                             Glyph="&#xE9EA;"
                                             IsChevronVisible="True" />
                </controls:HeaderedControl>

                <controls:HeaderedControl>
                    <controls:SettingsButton Content="{CustomResource InterfaceScale}"
                                             Glyph="&#xEA89;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.ScalingOptions}"
                                                       SelectedIndex="{x:Bind ViewModel.Scaling, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <Grid Background="{ThemeResource SettingsItemBackground}"
                          BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="24"
                                Height="24"
                                Margin="16,0,18,0">
                            <TextBlock FontSize="25"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw"
                                       Text="&#xE9E8;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </Border>

                        <TextBlock x:Name="BubbleRadiusHeader"
                                   Text="{CustomResource BubbleRadius}"
                                   FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                   VerticalAlignment="Center"
                                   Grid.Column="1" />
                        <Slider x:Name="BubbleRadiusSlider"
                                Value="{x:Bind ViewModel.BubbleRadius, Mode=TwoWay}"
                                AutomationProperties.Name="{CustomResource BubbleRadius}"
                                Minimum="0"
                                Maximum="15"
                                SmallChange="1"
                                LargeChange="1"
                                IsThumbToolTipEnabled="False"
                                Margin="12,6,16,6"
                                Grid.Column="2"
                                Grid.ColumnSpan="3" />
                    </Grid>
                    <Grid Background="{ThemeResource SettingsItemBackground}"
                          BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="24"
                                Height="24"
                                Margin="16,0,18,0">
                            <TextBlock FontSize="25"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw"
                                       Text="&#xE9EB;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </Border>

                        <TextBlock x:Name="TextSizeHeader"
                                   Text="{CustomResource TextSizeHeader}"
                                   FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                   VerticalAlignment="Center"
                                   Grid.Column="1" />
                        <Slider x:Name="FontSizeSlider"
                                Value="{x:Bind ViewModel.FontSize, Mode=TwoWay}"
                                AutomationProperties.Name="{CustomResource TextSizeHeader}"
                                Minimum="0"
                                Maximum="6"
                                SmallChange="1"
                                LargeChange="1"
                                IsThumbToolTipEnabled="False"
                                Margin="12,6,16,6"
                                Grid.Column="2"
                                Grid.ColumnSpan="3" />
                    </Grid>
                    <controls:SettingsButton Content="{CustomResource FontFamily}"
                                             Glyph="&#xEAA9;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.FontFamilyOptions}"
                                                       SelectedIndex="{x:Bind ViewModel.FontFamily, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:SettingsOptionFontFamily">
                                        <TextBlock Text="{x:Bind Text}"
                                                   FontFamily="{x:Bind FontFamily}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </controls:SettingsComboBox>
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                </controls:HeaderedControl>

                <controls:HeaderedControl Header="Заокруглення"
                                          Footer="Загальний повзунок задає заокруглення всьому, що ви не змінили окремо; категорія — своїм елементам (розгорніть стрілкою). Змінене окремо позначено «окремо» й загальним повзунком не скидається; з «Синхронно» будь-який повзунок задає одне значення всьому. Шапки, поле вводу, реакції й пункти змінюються одразу; кнопки, поля, меню й капсули — у щойно відкритих сторінках і вікнах, повністю — після перезапуску.">
                    <CheckBox common:ToggleHelper.IsChecked="{x:Bind ViewModel.RadiusSync, Mode=TwoWay}"
                              AutomationProperties.Name="Синхронне заокруглення"
                              Content="Змінювати все синхронно"
                              Style="{StaticResource SettingsCheckBoxStyle}" />
                    <Grid Background="{ThemeResource SettingsItemBackground}"
                          BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="24"
                                Height="24"
                                Margin="16,0,18,0">
                            <TextBlock FontSize="25"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw"
                                       Text="&#xF7AB;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </Border>

                        <TextBlock Text="{x:Bind ViewModel.RadiusMaster.Text, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Grid.Column="1" />
                        <Slider Value="{x:Bind ViewModel.RadiusMaster.Value, Mode=TwoWay}"
                                AutomationProperties.Name="Загальне заокруглення"
                                Minimum="0"
                                Maximum="28"
                                SmallChange="1"
                                LargeChange="4"
                                StepFrequency="1"
                                IsThumbToolTipEnabled="False"
                                Margin="12,6,16,6"
                                Grid.Column="2" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.RadiusCategories}"
                                  IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:RadiusNodeViewModel">
                                <StackPanel Margin="0,0,0,2">
                                    <Grid Background="{ThemeResource SettingsItemBackground}"
                                          BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                                          BorderThickness="1"
                                          CornerRadius="{x:Bind Corner, Mode=OneWay}"
                                          MinHeight="46">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="208" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton IsChecked="{x:Bind IsExpanded, Mode=TwoWay}"
                                                      Visibility="{x:Bind HasChildren}"
                                                      AutomationProperties.Name="{x:Bind Label}"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Width="36"
                                                      Height="36"
                                                      Padding="0"
                                                      Margin="12,0,10,0">
                                            <!-- An expander's chevron, not a pressed button: no fill when open, it turns instead. -->
                                            <ToggleButton.Resources>
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#14FFFFFF" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#0AFFFFFF" />
                                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                            </ToggleButton.Resources>
                                            <FontIcon Glyph="{x:Bind ExpandGlyph, Mode=OneWay}"
                                                      FontSize="12" />
                                        </ToggleButton>
                                        <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Grid.Column="1" />
                                        <Slider Value="{x:Bind Value, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind Label}"
                                                Minimum="0"
                                                Maximum="28"
                                                SmallChange="1"
                                                LargeChange="4"
                                                StepFrequency="1"
                                                IsThumbToolTipEnabled="False"
                                                VerticalAlignment="Center"
                                                Margin="12,6,16,6"
                                                Grid.Column="2" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{x:Bind Children}"
                                                  Visibility="{x:Bind IsExpanded, Mode=OneWay}"
                                                  IsTabStop="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:RadiusNodeViewModel">
                                                <Grid Background="{ThemeResource SettingsItemBackground}"
                                                      BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                                                      BorderThickness="1"
                                                      CornerRadius="{x:Bind Corner, Mode=OneWay}"
                                                      MinHeight="42"
                                                      Margin="24,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="58" />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="208" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                                               Style="{StaticResource BodyTextBlockStyle}"
                                                               Opacity="0.85"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Grid.Column="1" />
                                                    <Slider Value="{x:Bind Value, Mode=TwoWay}"
                                                            AutomationProperties.Name="{x:Bind Label}"
                                                            Minimum="0"
                                                            Maximum="28"
                                                            SmallChange="1"
                                                            LargeChange="4"
                                                            StepFrequency="1"
                                                            IsThumbToolTipEnabled="False"
                                                            VerticalAlignment="Center"
                                                            Margin="12,6,16,6"
                                                            Grid.Column="2" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <controls:SettingsButton Content="Повернути все до загального"
                                             Click="{x:Bind ViewModel.ResetRadii}"
                                             Glyph="&#xE7A7;" />
                </controls:HeaderedControl>

                <controls:HeaderedControl Header="Прозорість"
                                          Footer="Матеріал вікна потребує увімкнених ефектів прозорості в Windows. Розмиття показує розмиті вікна позаду, акрил — те саме під тінтом Windows.">
                    <Grid Background="{ThemeResource SettingsItemBackground}"
                          BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="24"
                                Height="24"
                                Margin="16,0,18,0">
                            <TextBlock FontSize="25"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw"
                                       Text="&#xF7AC;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </Border>

                        <TextBlock Text="{x:Bind ConvertPercent('Насиченість кольорів теми', ViewModel.ThemeSaturation), Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Grid.Column="1" />
                        <Slider Value="{x:Bind ViewModel.ThemeSaturation, Mode=TwoWay}"
                                AutomationProperties.Name="Насиченість кольорів теми"
                                Minimum="0"
                                Maximum="150"
                                SmallChange="5"
                                LargeChange="10"
                                StepFrequency="5"
                                IsThumbToolTipEnabled="False"
                                Margin="12,6,16,6"
                                Grid.Column="2" />
                    </Grid>
                    <controls:SettingsButton Content="Матеріал вікна"
                                             Glyph="&#xF7AD;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.WindowMaterialOptions}"
                                                       AutomationProperties.Name="Матеріал вікна"
                                                       SelectedIndex="{x:Bind ViewModel.WindowMaterialIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Скло бічної панелі"
                                             Glyph="&#xF7AE;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.GlassOptions}"
                                                       AutomationProperties.Name="Скло бічної панелі"
