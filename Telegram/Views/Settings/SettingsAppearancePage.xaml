<local:HostedPage x:Class="Telegram.Views.Settings.SettingsAppearancePage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:contract7Present="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract, 7)"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:common="using:Telegram.Common"
                  xmlns:controls="using:Telegram.Controls"
                  xmlns:cells="using:Telegram.Controls.Cells"
                  xmlns:chats="using:Telegram.Controls.Chats"
                  xmlns:messages="using:Telegram.Controls.Messages"
                  xmlns:local="using:Telegram.Views"
                  xmlns:viewModels="using:Telegram.ViewModels.Settings"
                  mc:Ignorable="d"
                  NavigationMode="Root"
                  ActualThemeChanged="OnActualThemeChanged">

    <Grid Background="{ThemeResource SettingsPageBackground}">
        <contract7Present:Grid.BackgroundTransition>
            <contract7Present:BrushTransition />
        </contract7Present:Grid.BackgroundTransition>
        <ScrollViewer x:Name="ScrollingHost"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <controls:SettingsPanel SizeChanged="OnSizeChanged">
                <controls:HeaderedControl>
                    <Grid Background="{ThemeResource SettingsItemBackground}"
                          BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="Preview"
                              CornerRadius="4,4,0,0">
                            <chats:ChatBackgroundControl x:Name="BackgroundControl"
                                                         CornerRadius="4,4,0,0" />
                            <StackPanel x:Name="Bubbles"
                                        Padding="0,4,0,12">
                                <messages:MessageBubble x:Name="Message1"
                                                        HorizontalAlignment="Left" />
                                <messages:MessageBubble x:Name="Message2"
                                                        HorizontalAlignment="Right"
                                                        IsOutgoing="True" />
                            </StackPanel>
                        </Grid>

                        <ListView x:Name="List"
                                  ItemsSource="{x:Bind ViewModel.ChatThemes}"
                                  SelectedItem="{x:Bind ViewModel.SelectedChatTheme, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  SingleSelectionFollowsFocus="False"
                                  SelectionChanged="OnSelectionChanged"
                                  ChoosingItemContainer="OnChoosingItemContainer"
                                  ContainerContentChanging="OnContainerContentChanging"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                  ScrollViewer.HorizontalScrollMode="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  Padding="12,12,0,8"
                                  Grid.Row="1">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <cells:ChatThemeCell Width="87" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="controls:MultipleListViewItem">
                                    <Setter Property="Padding"
                                            Value="0" />
                                    <Setter Property="CornerRadius"
                                            Value="4" />
                                    <Setter Property="Margin"
                                            Value="0,0,4,4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.Footer>
                                <Border Width="8" />
                            </ListView.Footer>
                        </ListView>
                    </Grid>

                    <controls:SettingsButton Content="{CustomResource ChatThemes}"
                                             Click="{x:Bind ViewModel.OpenThemes}"
                                             Glyph="&#xE90E;"
                                             IsChevronVisible="True" />

                    <controls:SettingsButton Content="{CustomResource ChatWallpaper}"
                                             Click="{x:Bind ViewModel.OpenWallpaper}"
                                             Glyph="&#xE9E7;"
                                             IsChevronVisible="True" />

                    <controls:SettingsButton x:Name="NameColor"
                                             Content="{CustomResource YourNameColor}"
                                             Click="{x:Bind ViewModel.ChangeProfileColor}"
                                             Glyph="&#xE2B1;"
                                             IsChevronVisible="True">
                        <controls:SettingsButton.Badge>
                            <controls:ProfileColorBadge x:Name="ProfileColor" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                </controls:HeaderedControl>

                <controls:HeaderedControl>
                    <CheckBox Content="{CustomResource SettingsSwitchToNightMode}"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              common:ToggleHelper.IsChecked="{x:Bind ViewModel.ForceNightMode, Mode=TwoWay}" />
                    <controls:SettingsButton Content="{CustomResource AutoNightTheme}"
                                             Badge="{x:Bind ConvertNightMode(ViewModel.NightMode), Mode=OneWay}"
                                             Click="{x:Bind ViewModel.OpenNightMode}"
                                             Glyph="&#xE9EA;"
                                             IsChevronVisible="True" />
                </controls:HeaderedControl>

                <controls:HeaderedControl>
                    <controls:SettingsButton Content="{CustomResource InterfaceScale}"
                                             Glyph="&#xEA89;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.ScalingOptions}"
                                                       SelectedIndex="{x:Bind ViewModel.Scaling, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <Grid Background="{ThemeResource SettingsItemBackground}"
                          BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="24"
                                Height="24"
                                Margin="16,0,18,0">
                            <TextBlock FontSize="25"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw"
                                       Text="&#xE9E8;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </Border>

                        <TextBlock x:Name="BubbleRadiusHeader"
                                   Text="{CustomResource BubbleRadius}"
                                   FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                   VerticalAlignment="Center"
                                   Grid.Column="1" />
                        <Slider x:Name="BubbleRadiusSlider"
                                Value="{x:Bind ViewModel.BubbleRadius, Mode=TwoWay}"
                                AutomationProperties.Name="{CustomResource BubbleRadius}"
                                Minimum="0"
                                Maximum="15"
                                SmallChange="1"
                                LargeChange="1"
                                IsThumbToolTipEnabled="False"
                                Margin="12,6,16,6"
                                Grid.Column="2"
                                Grid.ColumnSpan="3" />
                    </Grid>
                    <Grid Background="{ThemeResource SettingsItemBackground}"
                          BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="24"
                                Height="24"
                                Margin="16,0,18,0">
                            <TextBlock FontSize="25"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw"
                                       Text="&#xE9EB;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </Border>

                        <TextBlock x:Name="TextSizeHeader"
                                   Text="{CustomResource TextSizeHeader}"
                                   FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                   VerticalAlignment="Center"
                                   Grid.Column="1" />
                        <Slider x:Name="FontSizeSlider"
                                Value="{x:Bind ViewModel.FontSize, Mode=TwoWay}"
                                AutomationProperties.Name="{CustomResource TextSizeHeader}"
                                Minimum="0"
                                Maximum="6"
                                SmallChange="1"
                                LargeChange="1"
                                IsThumbToolTipEnabled="False"
                                Margin="12,6,16,6"
                                Grid.Column="2"
                                Grid.ColumnSpan="3" />
                    </Grid>
                    <controls:SettingsButton Content="{CustomResource FontFamily}"
                                             Glyph="&#xEAA9;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.FontFamilyOptions}"
                                                       SelectedIndex="{x:Bind ViewModel.FontFamily, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:SettingsOptionFontFamily">
                                        <TextBlock Text="{x:Bind Text}"
                                                   FontFamily="{x:Bind FontFamily}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </controls:SettingsComboBox>
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                </controls:HeaderedControl>

                <controls:HeaderedControl Header="Прозорість"
                                          Footer="Матеріал вікна потребує увімкнених ефектів прозорості в Windows. Розмиття показує розмиті вікна позаду, акрил — те саме під тінтом Windows.">
                    <controls:SettingsButton Content="Матеріал вікна"
                                             Glyph="&#xEA89;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.WindowMaterialOptions}"
                                                       AutomationProperties.Name="Матеріал вікна"
                                                       SelectedIndex="{x:Bind ViewModel.WindowMaterialIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Скло бічної панелі"
                                             Glyph="&#xEA89;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.GlassOptions}"
                                                       AutomationProperties.Name="Скло бічної панелі"
                                                       SelectedIndex="{x:Bind ViewModel.PaneGlassIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Розташування папок"
                                             Glyph="&#xEAA9;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.FoldersPlacementOptions}"
                                                       AutomationProperties.Name="Розташування папок"
                                                       SelectedIndex="{x:Bind ViewModel.FoldersPlacementIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Лінії між елементами"
                                             Glyph="&#xEA89;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.SeparatorModeOptions}"
                                                       AutomationProperties.Name="Лінії між елементами"
                                                       SelectedIndex="{x:Bind ViewModel.SeparatorModeIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Шапка сторінок"
                                             Glyph="&#xEA89;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.HeaderStyleOptions}"
                                                       AutomationProperties.Name="Шапка сторінок"
                                                       SelectedIndex="{x:Bind ViewModel.HeaderStyleIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Скло шапки сторінок"
                                             Glyph="&#xEA89;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.GlassOptions}"
                                                       AutomationProperties.Name="Скло шапки сторінок"
                                                       SelectedIndex="{x:Bind ViewModel.HeaderGlassIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>                    <controls:SettingsButton Content="Шапка чату"
                                             Glyph="&#xEA89;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.ChatHeaderStyleOptions}"
                                                       AutomationProperties.Name="Шапка чату"
                                                       SelectedIndex="{x:Bind ViewModel.ChatHeaderStyleIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Скло шапки чату"
                                             Glyph="&#xEA89;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.GlassOptions}"
                                                       AutomationProperties.Name="Скло шапки чату"
                                                       SelectedIndex="{x:Bind ViewModel.ChatHeaderGlassIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>                    <controls:SettingsButton Content="Скло нижньої панелі каналу"
                                             Glyph="&#xEA89;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.GlassOptions}"
                                                       AutomationProperties.Name="Скло нижньої панелі каналу"
                                                       SelectedIndex="{x:Bind ViewModel.FooterGlassIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>                    <Grid Background="{ThemeResource SettingsItemBackground}"
                          BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="24"
                                Height="24"
                                Margin="16,0,18,0">
                            <TextBlock FontSize="25"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw"
                                       Text="&#xE9E8;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </Border>

                        <TextBlock Text="{x:Bind ConvertPercent('Непрозорість фону', ViewModel.BackgroundOpacity), Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Grid.Column="1" />
                        <Slider Value="{x:Bind ViewModel.BackgroundOpacity, Mode=TwoWay}"
                                AutomationProperties.Name="Непрозорість фону"
                                Minimum="10"
                                Maximum="100"
                                SmallChange="5"
                                LargeChange="10"
                                StepFrequency="5"
                                IsThumbToolTipEnabled="False"
                                Margin="12,6,16,6"
                                Grid.Column="2" />
                    </Grid>
                    <CheckBox common:ToggleHelper.IsChecked="{x:Bind ViewModel.IsWallpaperEnabled, Mode=TwoWay}"
                              AutomationProperties.Name="Показувати шпалери"
                              Content="Показувати шпалери в чатах"
                              Style="{StaticResource SettingsCheckBoxStyle}" />
                    <Grid Background="{ThemeResource SettingsItemBackground}"
                          BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="24"
                                Height="24"
                                Margin="16,0,18,0">
                            <TextBlock FontSize="25"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw"
                                       Text="&#xE9EB;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </Border>

                        <TextBlock Text="{x:Bind ConvertPercent('Непрозорість шпалер', ViewModel.WallpaperOpacity), Mode=OneWay}"
                                   Opacity="{x:Bind ConvertEnabledOpacity(ViewModel.IsWallpaperEnabled), Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Grid.Column="1" />
                        <Slider Value="{x:Bind ViewModel.WallpaperOpacity, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsWallpaperEnabled, Mode=OneWay}"
                                AutomationProperties.Name="Непрозорість шпалер"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="5"
                                LargeChange="10"
                                StepFrequency="5"
                                IsThumbToolTipEnabled="False"
                                Margin="12,6,16,6"
                                Grid.Column="2" />
                    </Grid>
                </controls:HeaderedControl>

                <controls:HeaderedControl Header="Ефекти скла"
                                          Footer="Діють на всі елементи зі склом: обідок — на капсули, шапки, нижню панель і бульбашки; сяйво — на внутрішнє світло та світіння тексту; розгортка — на ретро-термінали; розмиття — на все скло.">
                    <controls:SettingsButton Content="Обідок скла"
                                             Glyph="&#xEA89;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.RimStyleOptions}"
                                                       AutomationProperties.Name="Обідок скла"
                                                       SelectedIndex="{x:Bind ViewModel.RimStyleIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <Grid Background="{ThemeResource SettingsItemBackground}"
                          BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="24"
                                Height="24"
                                Margin="16,0,18,0">
                            <TextBlock FontSize="25"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw"
                                       Text="&#xEA89;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </Border>

                        <TextBlock Text="{x:Bind ConvertPercent('Яскравість обідка', ViewModel.RimIntensity), Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Grid.Column="1" />
                        <Slider Value="{x:Bind ViewModel.RimIntensity, Mode=TwoWay}"
                                AutomationProperties.Name="Яскравість обідка"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="5"
                                LargeChange="10"
                                StepFrequency="5"
                                IsThumbToolTipEnabled="False"
                                Margin="12,6,16,6"
                                Grid.Column="2" />
                    </Grid>                    <Grid Background="{ThemeResource SettingsItemBackground}"
                          BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="24"
                                Height="24"
                                Margin="16,0,18,0">
                            <TextBlock FontSize="25"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw"
                                       Text="&#xE9E8;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </Border>

                        <TextBlock Text="{x:Bind ConvertPercent('Сила сяйва', ViewModel.GlowIntensity), Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Grid.Column="1" />
                        <Slider Value="{x:Bind ViewModel.GlowIntensity, Mode=TwoWay}"
                                AutomationProperties.Name="Сила сяйва"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="5"
                                LargeChange="10"
                                StepFrequency="5"
                                IsThumbToolTipEnabled="False"
                                Margin="12,6,16,6"
                                Grid.Column="2" />
                    </Grid>                    <Grid Background="{ThemeResource SettingsItemBackground}"
                          BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="24"
                                Height="24"
                                Margin="16,0,18,0">
                            <TextBlock FontSize="25"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw"
                                       Text="&#xE9E8;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </Border>

                        <TextBlock Text="{x:Bind ConvertPercent('Лінії розгортки', ViewModel.ScanlineIntensity), Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Grid.Column="1" />
                        <Slider Value="{x:Bind ViewModel.ScanlineIntensity, Mode=TwoWay}"
                                AutomationProperties.Name="Лінії розгортки"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="5"
                                LargeChange="10"
                                StepFrequency="5"
                                IsThumbToolTipEnabled="False"
                                Margin="12,6,16,6"
                                Grid.Column="2" />
                    </Grid>                    <Grid Background="{ThemeResource SettingsItemBackground}"
                          BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="24"
                                Height="24"
                                Margin="16,0,18,0">
                            <TextBlock FontSize="25"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw"
                                       Text="&#xEA89;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </Border>

                        <TextBlock Text="{x:Bind ConvertPercent('Сила розмиття', ViewModel.BlurIntensity), Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Grid.Column="1" />
                        <Slider Value="{x:Bind ViewModel.BlurIntensity, Mode=TwoWay}"
                                AutomationProperties.Name="Сила розмиття"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="5"
                                LargeChange="10"
                                StepFrequency="5"
                                IsThumbToolTipEnabled="False"
                                Margin="12,6,16,6"
                                Grid.Column="2" />
                    </Grid>                </controls:HeaderedControl>

                <controls:HeaderedControl Header="Майданчик"
                                          Footer="Живий приклад: шпалери, бульбашки, реакції, дати й шапка змінюються разом із налаштуваннями нижче. Прокрутіть його, щоб побачити, як повідомлення заходять під шапку.">
                    <Grid x:Name="Playground"
                          AutomationProperties.Name="Майданчик"
                          Height="320"
                          CornerRadius="4">
                        <chats:ChatBackgroundControl x:Name="PlaygroundBackground"
                                                     CornerRadius="4" />

                        <ScrollViewer x:Name="PlaygroundScroll"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Enabled"
                                      HorizontalScrollMode="Disabled">
                            <StackPanel x:Name="PlaygroundBubbles"
                                        Padding="0,64,0,16"
                                        Spacing="6">
                                <messages:MessageService HorizontalAlignment="Center">
                                    <TextBlock Text="Сьогодні"
                                               Foreground="White"
                                               FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </messages:MessageService>

                                <messages:MessageBubble x:Name="PlaygroundIncoming"
                                                        HorizontalAlignment="Left" />

                                <!-- The capsules a message's reactions are drawn in, painted with
                                     the same brushes, so they change with the reaction style. -->
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4"
                                            Margin="58,0,0,0">
                                    <Grid MinWidth="44"
                                          Height="28"
                                          Padding="8,0"
                                          CornerRadius="14"
                                          Background="{ThemeResource MessageReactionChosenBackgroundBrush}">
                                        <Border BorderBrush="{ThemeResource MessageReactionBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Margin="-8,0" />
                                        <TextBlock Text="❤ 24"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                                   Foreground="{ThemeResource MessageReactionChosenForegroundBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Grid>
                                    <Grid MinWidth="44"
                                          Height="28"
                                          Padding="8,0"
                                          CornerRadius="14"
                                          Background="{ThemeResource MessageReactionBackgroundBrush}">
                                        <Border BorderBrush="{ThemeResource MessageReactionBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Margin="-8,0" />
                                        <TextBlock Text="🔥 7"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                                   Foreground="{ThemeResource MessageReactionForegroundBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Grid>
                                </StackPanel>

                                <messages:MessageBubble x:Name="PlaygroundOutgoing"
                                                        HorizontalAlignment="Right"
                                                        IsOutgoing="True" />

                                <messages:MessageService HorizontalAlignment="Center">
                                    <TextBlock Text="Олена приєдналася до групи"
                                               Foreground="White"
                                               FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </messages:MessageService>

                                <messages:MessageBubble x:Name="PlaygroundIncoming2"
                                                        HorizontalAlignment="Left" />

                                <messages:MessageBubble x:Name="PlaygroundOutgoing2"
                                                        HorizontalAlignment="Right"
                                                        IsOutgoing="True" />

                                <messages:MessageBubble x:Name="PlaygroundIncoming3"
                                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- The header the pages scroll under, in both of its forms. -->
                        <Border x:Name="PlaygroundHeaderOriginal"
                                Height="48"
                                VerticalAlignment="Top"
                                Background="{ThemeResource PageSubHeaderBackgroundBrush2}"
                                BorderBrush="{ThemeResource NavigationViewContentGridBorderBrush}"
                                BorderThickness="0,0,0,1"
                                IsHitTestVisible="False" />
                        <Border x:Name="PlaygroundHeaderGlass"
                                Height="72"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False" />
                        <TextBlock x:Name="PlaygroundTitle"
                                   Text="Олена"
                                   FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                   FontWeight="SemiBold"
                                   Margin="16,12,16,0"
                                   VerticalAlignment="Top"
                                   IsHitTestVisible="False" />
                    </Grid>
                </controls:HeaderedControl>

                <controls:HeaderedControl Header="Повідомлення"
                                          Footer="Кольори змінюються одразу. Матове скло й сяйво бульбашок з'являються на повідомленнях, щойно вони перемальовуються: прокрутіть або знову відкрийте чат.">
                    <controls:SettingsButton Content="{CustomResource ChatThemes}"
                                             Click="{x:Bind ViewModel.OpenThemes}"
                                             Glyph="&#xE90E;"
                                             IsChevronVisible="True" />
                    <controls:SettingsButton Content="{CustomResource ChatWallpaper}"
                                             Click="{x:Bind ViewModel.OpenWallpaper}"
                                             Glyph="&#xE9E7;"
                                             IsChevronVisible="True" />

                    <CheckBox common:ToggleHelper.IsChecked="{x:Bind ViewModel.UseCustomMessageColors, Mode=TwoWay}"
                              AutomationProperties.Name="Власні кольори"
                              Content="Власні кольори повідомлень (замість кольорів теми)"
                              Style="{StaticResource SettingsCheckBoxStyle}" />
                    <controls:SettingsButton Content="Вхідні бульбашки"
                                             Tag="CustomIncomingColor"
                                             Click="CustomColor_Click"
                                             IsEnabled="{x:Bind ViewModel.UseCustomMessageColors, Mode=OneWay}"
                                             Glyph="&#xE9E8;">
                        <controls:SettingsButton.Badge>
                            <Border Width="36" Height="22" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                                    Background="{x:Bind ViewModel.CustomIncomingBrush, Mode=OneWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Вихідні бульбашки"
                                             Tag="CustomOutgoingColor"
                                             Click="CustomColor_Click"
                                             IsEnabled="{x:Bind ViewModel.UseCustomMessageColors, Mode=OneWay}"
                                             Glyph="&#xE9E8;">
                        <controls:SettingsButton.Badge>
                            <Border Width="36" Height="22" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                                    Background="{x:Bind ViewModel.CustomOutgoingBrush, Mode=OneWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Текст вхідних"
                                             Tag="CustomIncomingTextColor"
                                             Click="CustomColor_Click"
                                             IsEnabled="{x:Bind ViewModel.UseCustomMessageColors, Mode=OneWay}"
                                             Glyph="&#xE9EB;">
                        <controls:SettingsButton.Badge>
                            <Border Width="36" Height="22" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                                    Background="{x:Bind ViewModel.CustomIncomingTextBrush, Mode=OneWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Текст вихідних"
                                             Tag="CustomOutgoingTextColor"
                                             Click="CustomColor_Click"
                                             IsEnabled="{x:Bind ViewModel.UseCustomMessageColors, Mode=OneWay}"
                                             Glyph="&#xE9EB;">
                        <controls:SettingsButton.Badge>
                            <Border Width="36" Height="22" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                                    Background="{x:Bind ViewModel.CustomOutgoingTextBrush, Mode=OneWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Капсули реакцій (колір)"
                                             Tag="CustomReactionColor"
                                             Click="CustomColor_Click"
                                             IsEnabled="{x:Bind ViewModel.UseCustomMessageColors, Mode=OneWay}"
                                             Glyph="&#xE9E8;">
                        <controls:SettingsButton.Badge>
                            <Border Width="36" Height="22" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                                    Background="{x:Bind ViewModel.CustomReactionBrush, Mode=OneWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>

                    <controls:SettingsButton Content="Бульбашки"
                                             Glyph="&#xE9E8;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.GlassOptions}"
                                                       AutomationProperties.Name="Бульбашки"
                                                       SelectedIndex="{x:Bind ViewModel.BubbleGlassIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <Grid Background="{ThemeResource SettingsItemBackground}"
                          BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="24"
                                Height="24"
                                Margin="16,0,18,0">
                            <TextBlock FontSize="25"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw"
                                       Text="&#xE9E8;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </Border>

                        <TextBlock Text="{x:Bind ConvertPercent('Непрозорість бульбашок', ViewModel.BubbleOpacity), Mode=OneWay}"
                                   Opacity="{x:Bind ConvertEnabledOpacity(ViewModel.IsBubbleGlass), Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Grid.Column="1" />
                        <Slider Value="{x:Bind ViewModel.BubbleOpacity, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsBubbleGlass, Mode=OneWay}"
                                AutomationProperties.Name="Непрозорість бульбашок"
                                Minimum="20"
                                Maximum="100"
                                SmallChange="5"
                                LargeChange="10"
                                StepFrequency="5"
                                IsThumbToolTipEnabled="False"
                                Margin="12,6,16,6"
                                Grid.Column="2" />
                    </Grid>
                    <controls:SettingsButton Content="Капсули реакцій"
                                             Glyph="&#xE9E8;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.GlassOptions}"
                                                       AutomationProperties.Name="Капсули реакцій"
                                                       SelectedIndex="{x:Bind ViewModel.ReactionGlassIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Дати й сервісні повідомлення"
                                             Glyph="&#xE9E8;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.GlassOptions}"
                                                       AutomationProperties.Name="Сервісні капсули"
                                                       SelectedIndex="{x:Bind ViewModel.ServiceGlassIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="Текст у повідомленнях"
                                             Glyph="&#xE9EB;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.MessageTextStyleOptions}"
                                                       AutomationProperties.Name="Текст у повідомленнях"
                                                       SelectedIndex="{x:Bind ViewModel.MessageTextStyleIndex, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                </controls:HeaderedControl>

                <controls:HeaderedControl Footer="{CustomResource StickersNameInfo}">
                    <controls:SettingsButton Content="{CustomResource StickersName}"
                                             Click="{x:Bind ViewModel.OpenStickers}"
                                             Glyph="&#xF4AA;"
                                             IsChevronVisible="True" />
                </controls:HeaderedControl>

                <controls:HeaderedControl Header="{CustomResource ChatQuickActions}">
                    <CheckBox common:ToggleHelper.IsChecked="{x:Bind ViewModel.SwipeToShare, Mode=TwoWay}"
                              Content="{CustomResource SwipeShare}"
                              Style="{StaticResource SettingsCheckBoxStyle}" />

                    <CheckBox common:ToggleHelper.IsChecked="{x:Bind ViewModel.SwipeToReply, Mode=TwoWay}"
                              Content="{CustomResource SwipeReply}"
                              Style="{StaticResource SettingsCheckBoxStyle}" />

                    <CheckBox common:ToggleHelper.IsChecked="{x:Bind ViewModel.SwipeToGoBack, Mode=TwoWay}"
                              Content="{CustomResource SwipeGoBack}"
                              Style="{StaticResource SettingsCheckBoxStyle}" />
                </controls:HeaderedControl>

                <controls:HeaderedControl Header="{CustomResource ChatDoubleClickAction}"
                                          Footer="{x:Bind ConvertQuickAction(ViewModel.DoubleClickToReply), Mode=OneWay}">
                    <controls:SettingsRadioButton common:ToggleHelper.IsChecked="{x:Bind ViewModel.DoubleClickToReply, Mode=TwoWay}"
                                                  Content="{CustomResource DoubleClickReply}"
                                                  GroupName="DoubleClick" />
                    <Grid BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                        <controls:SettingsRadioButton common:ToggleHelper.IsChecked="{x:Bind ViewModel.DoubleClickToReact, Mode=TwoWay}"
                                                      Content="{CustomResource DoubleClickReact}"
                                                      MinHeight="46"
                                                      GroupName="DoubleClick"
                                                      CornerRadius="4" />
                        <messages:ReactionButton x:Name="Reaction"
                                                 Click="Reaction_Click"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,16,0" />
                    </Grid>
                </controls:HeaderedControl>

                <controls:HeaderedControl Header="{CustomResource OtherSettings}">
                    <CheckBox common:ToggleHelper.IsChecked="{x:Bind ViewModel.FullScreenGallery, Mode=TwoWay}"
                              Content="{CustomResource EnableFullScreenGallery}"
                              Style="{StaticResource SettingsCheckBoxStyle}" />

                    <CheckBox common:ToggleHelper.IsChecked="{x:Bind ViewModel.UseSystemSpellChecker, Mode=TwoWay}"
                              Content="{CustomResource UseSystemSpellChecker}"
                              Style="{StaticResource SettingsCheckBoxStyle}" />

                    <CheckBox common:ToggleHelper.IsChecked="{x:Bind ViewModel.IsReplaceEmojiEnabled, Mode=TwoWay}"
                              Content="{CustomResource ReplaceEmoji}"
                              Style="{StaticResource SettingsCheckBoxStyle}" />

                    <CheckBox common:ToggleHelper.IsChecked="{x:Bind ViewModel.IsAdaptiveWideEnabled, Mode=TwoWay}"
                              Content="{CustomResource AdaptiveLayout}"
                              Style="{StaticResource SettingsCheckBoxStyle}" />

                    <controls:SettingsButton Content="{CustomResource SendByEnter2}"
                                             Glyph="&#xE919;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.SendByOptions}"
                                                       SelectedIndex="{x:Bind ViewModel.SendBy, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                    <controls:SettingsButton Content="{CustomResource DistanceUnits}"
                                             Glyph="&#xE1C4;">
                        <controls:SettingsButton.Badge>
                            <controls:SettingsComboBox ItemsSource="{x:Bind ViewModel.DistanceUnitOptions}"
                                                       SelectedIndex="{x:Bind ViewModel.DistanceUnit, Mode=TwoWay}" />
                        </controls:SettingsButton.Badge>
                    </controls:SettingsButton>
                </controls:HeaderedControl>
            </controls:SettingsPanel>
        </ScrollViewer>
    </Grid>
</local:HostedPage>
